# Настройки deploy.sh. Скопируйте в корень каталога сайта как deploy.env (рядом с deploy.sh).
# Файл не в репозитории — паролей здесь нет, только параметры выкладки.

# Откуда брать код (github-wh — псевдоним из ~/.ssh/config с отдельным deploy key)
DEPLOY_REPO=git@github-wh:konkotds-gif/warehouse_service.git
# Ветка по умолчанию для ./deploy.sh без аргументов
DEPLOY_BRANCH=claude/project-thread-a2b3r2
# Сколько релизов хранить
DEPLOY_KEEP=5

# PHP 8.3+ определяется сам (/opt/php84/bin/php, /usr/bin/php8.4, …).
# Раскомментируйте, только если автоопределение не нашло нужный:
# PHP_BIN=/opt/php84/bin/php

# Если пользователю разрешён sudo systemctl reload — имя службы PHP-FPM:
# FPM_SERVICE=php8.4-fpm
